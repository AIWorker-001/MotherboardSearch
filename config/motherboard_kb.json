{
  "schema_version": 2,
  "catalog": "data/motherboard_kb/catalog.json",
  "reference_root": "data/motherboard_kb/references",
  "feature_root": "data/motherboard_kb/features",
  "sources": {
    "manufacturer": {
      "trust": 1.0,
      "requires_manual_approval": false
    },
    "review_site": {
      "trust": 0.95,
      "requires_manual_approval": false
    },
    "ebay": {
      "trust": 0.72,
      "requires_manual_approval": true,
      "minimum_agreeing_references": 2
    },
    "shopgoodwill_verified": {
      "trust": 0.98,
      "requires_manual_approval": false
    }
  },
  "matching": {
    "minimum_good_matches": 18,
    "minimum_inlier_ratio": 0.32,
    "minimum_identity_score": 0.58,
    "conflict_score": 0.42,
    "ratio_test": 0.75,
    "maximum_references_per_model": 12
  },
  "storage": {
    "backend": "local",
    "project": "MotherboardSearch",
    "namespace": "motherboard-kb",
    "cache_root": "data/motherboard_kb/cache",
    "coordinator_url": "",
    "token_env": "AIW_COORDINATOR_TOKEN"
  },
  "candidate_review": {
    "minimum_pair_score": 0.52,
    "minimum_agreeing_candidates": 2,
    "automatic_approval_source_types": [
      "manufacturer",
      "review_site",
      "shopgoodwill_verified"
    ]
  },
  "discovery": {
    "maximum_results_per_query": 8,
    "minimum_model_token_ratio": 0.6,
    "source_domains": {
      "manufacturer": [
        "asus.com",
        "gigabyte.com",
        "msi.com",
        "asrock.com",
        "biostar.com.tw",
        "evga.com",
        "supermicro.com",
        "intel.com"
      ],
      "review_site": [
        "anandtech.com",
        "tomshardware.com",
        "techpowerup.com",
        "kitguru.net",
        "hardwarecanucks.com",
        "tweaktown.com"
      ]
    },
    "marketplace_domains": [
      "ebay.com"
    ]
  }
}
